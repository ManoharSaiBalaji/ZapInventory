# ZapInventory Backend Environment Configuration

NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI (replace with your credentials and cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/zapinventory?retryWrites=true&w=majority

# Secret key for signing JSON Web Tokens (use a long, random string in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Frontend origin allowed to access the API (for CORS)
# Local: http://localhost:5173 | Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
